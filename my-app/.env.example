# ---- Database (Neon / PostgreSQL + pgvector) ----
# Runtime: pooled connection (used by PrismaNeon adapter)
DATABASE_URL=
# CLI migrations: direct connection (read by prisma7.config.ts)
DATABASE_URL_UNPOOLED=

# ---- Auth ----
NEXTAUTH_SECRET=

# ---- AI providers ----
# DeepSeek (agent, RAG generation)
OPEN_AI_API_KEY=
# OpenRouter (/api/chat, /api/analyze)
OPENROUTER_API_KEY=
# SiliconFlow (bge-m3 embeddings)
SILICONFLOW_API_KEY=

# ---- Email (agent sendEmail tool, 163 SMTP) ----
EMAIL_USER=
EMAIL_PASS=
